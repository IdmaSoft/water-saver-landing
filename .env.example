# Example environment variables for Water Saver / Gotita landing
# Copy this file to .env for local development.

# Public URL of the site (used for canonical, hreflang, Open Graph and sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" after the public launch on Google Play.
# While "false", the page shows "Coming soon to Google Play" and does not link to the store.
NEXT_PUBLIC_PLAY_LAUNCHED=false
